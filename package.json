{
  "name": "noc-fiberifi",
  "version": "1.0.0",
  "private": true,
  "description": "Fiberifi network operations panel: IPAM, customer subnets and rDNS (noc.fiberifi.com)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "net-snmp": "^3.29.2"
  }
}
